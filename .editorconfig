root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Go uses tabs (enforced by gofmt; non-negotiable across the ecosystem).
# This block makes the intent explicit so editors don't fight gofmt on save.
[*.go]
indent_style = tab
indent_size = 2

# Makefiles REQUIRE tabs (recipe lines) — same reason.
[Makefile]
indent_style = tab
indent_size = 2
